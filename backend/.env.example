# =============================================================================
# MRF Extraction Dashboard - backend configuration
# Copy to `.env` and adjust per host. Everything is env-driven so the SAME
# code runs on your local Windows box and on the deploy server (172.22.6.98).
# =============================================================================

# --- Database -----------------------------------------------------------------
# MySQL on 172.22.6.104, database `mrf_pro` (the KPI/job store for this app;
# `horizon_med` is a different application's schema and is left alone).
#
# Format: mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4
# The password's `!` is percent-encoded as %21 so the URL parses cleanly.
#
# Leave DATABASE_URL blank to fall back to a local SQLite file
# (backend/mrf_dashboard.db) for offline dev with no MySQL reachable.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@172.22.6.104:3306/mrf_pro?charset=utf8mb4

# --- File storage -----------------------------------------------------------
# Root under which /raw/{company}/{filename} and /output/{job_id}/ live.
# Relative paths are resolved against the repo root.
DATA_ROOT=./data

# --- HTTP / CORS ----------------------------------------------------------------
# Comma-separated list of allowed browser origins for the API.
# Local dev (Vite): http://localhost:5173
# Server: http://172.22.6.98  (add the port if you serve the UI on one)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# If you build the frontend and let FastAPI serve it, point this at the
# built dist folder. Blank = API only (frontend served separately by Vite).
FRONTEND_DIST=

# --- Upload -------------------------------------------------------------------
# Chunk size the client should use, in bytes (default 8 MiB).
UPLOAD_CHUNK_SIZE=8388608
# Hard ceiling on a single MRF upload, in bytes (default 25 GiB). 0 = no limit.
MAX_UPLOAD_BYTES=26843545600

# --- Worker ------------------------------------------------------------------
# stub  = fake progress (sleep loop) so the whole pipeline works end-to-end
#         without a real multi-GB file. Great for a first smoke test.
# real  = adapted extract_tic_all.py + enrich_npi_all.py logic (ijson stream
#         + NPPES enrichment).
EXTRACTION_MODE=real

# Seconds between queue polls when the worker is idle.
WORKER_POLL_INTERVAL=3.0
# A job whose heartbeat (updated_at) is older than this many seconds while
# still "processing" is considered dead and is requeued (or failed after
# WORKER_MAX_RETRIES attempts).
WORKER_STUCK_TIMEOUT=900
WORKER_MAX_RETRIES=2

# Rows per output CSV before rolling to the next file.
CSV_ROW_THRESHOLD=500000
# Hard cap on CSV parts per job; the last part grows past the row
# threshold instead of a 4001st file ever being created.
CSV_MAX_PARTS=4000
# Parallel NPPES lookup threads during the enrich stage.
NPI_LOOKUP_THREADS=8
# Cap on NPIs enriched per row. 0 = every NPI on the row (default) so every
# provider in the `npis` column gets its name/address/ZIP and a line in the
# providers sheet. Set e.g. 5 only if whole-network runs are too slow.
NPI_MAX_PER_ROW=0

# --- Payer MRF index resolution ----------------------------------------------
# Each payer's table-of-contents URL is hardcoded in app/payers.py as a
# date-templated pattern (payers re-publish monthly with the date in the path).
# The resolver expands the template over recent months and keeps the first URL
# that responds AND actually serves JSON.
#
# To pin an exact URL without touching code, create backend/payer_sources.json:
#   { "cigna": { "index_url": "https://.../2026-09-01_cigna_index.json.gz" } }
# or use the UI's "Pin index URL" action / POST /api/payers/{key}/index.
#
# How long a resolved index URL is cached before re-probing (seconds).
INDEX_CACHE_TTL=21600
# Max candidate URLs probed per payer while resolving.
INDEX_PROBE_LIMIT=12
INDEX_PROBE_TIMEOUT=12.0

# --- NPI / TIN provider search ------------------------------------------------
# Ceiling on in-network files enumerated from a payer's index. Anthem's index
# alone is ~10 GB and references millions of entries; we only need the head.
SEARCH_MAX_INDEX_ENTRIES=200
# Default number of files actually byte-scanned per search. The UI can raise
# this per search. Higher = slower but more thorough.
SEARCH_MAX_FILES=40
# How many files are scanned in parallel.
SEARCH_CONCURRENCY=6
# Per-file budgets - a probe stops at whichever comes first. SEARCH_PROBE_MAX_BYTES
# also sets the ranking cutoff for "fully scannable, prioritize by size" vs
# "over budget, deprioritized" (see mrf_index.rank_entries) - shrinking it
# pushes large, likely-to-matter files out of the priority tier and toward
# small/stub ones instead, so it's kept generous. SEARCH_PROBE_TIMEOUT is the
# safe lever for speed: it only bounds one probe's runtime, with no effect on
# which files get chosen.
SEARCH_PROBE_MAX_BYTES=419430400
SEARCH_PROBE_TIMEOUT=90.0
# A search with no heartbeat for this long is considered dead and requeued.
SEARCH_STUCK_TIMEOUT=1800

# --- Downloading payer-sourced MRFs -------------------------------------------
DOWNLOAD_TIMEOUT=180.0
# Keep the downloaded multi-GB MRF after extraction? Off by default - the
# CSV/zip output is the deliverable.
KEEP_DOWNLOADED_MRF=false

# --- Payer index store (backend/payer_index.json) ---------------------------
# Index URLs are resolved once and stored locally, then reused for this many
# days. A search does zero network work to find its index. Payers republish
# monthly, so 30 is the natural cadence.
INDEX_REFRESH_DAYS=30
# Refresh a signed URL (Cigna CloudFront, AWS presigned) this many seconds
# before its signature lapses, regardless of the monthly schedule.
INDEX_EXPIRY_MARGIN=21600
# Refresh stale entries on a background thread when the API starts.
INDEX_REFRESH_ON_STARTUP=true
