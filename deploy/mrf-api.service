# systemd unit for the FastAPI backend.
#   sudo cp deploy/mrf-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mrf-api
[Unit]
Description=MRF Extraction Dashboard API
After=network.target mysql.service

[Service]
Type=simple
User=mrf
WorkingDirectory=/opt/mrf-dashboard/backend
EnvironmentFile=/opt/mrf-dashboard/backend/.env
ExecStart=/opt/mrf-dashboard/backend/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
