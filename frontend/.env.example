# Frontend build/runtime config. Copy to `.env` (or `.env.local`).

# --- Dev only ---------------------------------------------------------------
# Where `vite dev` proxies /api to. Change if the backend runs elsewhere.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# --- Production build -----------------------------------------------------
# Base URL the built app calls for the API.
#  - leave BLANK if FastAPI serves the built files (same origin) OR if a
#    reverse proxy maps /api on the same host.
#  - set to the API origin when the UI and API are on different hosts/ports,
#    e.g. on the server:  VITE_API_BASE_URL=http://172.22.6.98:8000
VITE_API_BASE_URL=
